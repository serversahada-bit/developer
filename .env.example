# Database aplikasi Developer (sama dengan versi PHP).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=u313218767_dev

# Database aplikasi Absensi (tabel karyawan). Di server gunakan user read-only (SELECT karyawan, tim_saya).
ABSEN_DB_HOST=127.0.0.1
ABSEN_DB_PORT=3306
ABSEN_DB_USER=root
ABSEN_DB_PASSWORD=
ABSEN_DB_NAME=absensi

# Kunci tanda tangan cookie sesi aplikasi ini. Wajib diisi, minimal 32 karakter acak.
SESSION_SECRET=

# Kunci token SSO dari Great (absen-main). Harus sama dengan SSO_SECRET di Great.
# Kosongkan untuk menonaktifkan /sso.
SSO_SECRET=
# URL login Great, dipakai tombol "Masuk lewat Great" di halaman login (opsional).
GREAT_URL=

# Alamat aplikasi ini, dipakai untuk tautan pada email approval.
APP_BASE_URL=http://localhost:3002

# Token untuk POST /api/cron/approval-emails (pengiriman ulang antrean email). Minimal 32 karakter.
CRON_SECRET=

# SMTP notifikasi approval. MAIL_ENABLED=false menahan email di antrean.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=IT PSLU
